        },
        {
          "name": "Children of CAT001",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/categories/CAT001/children", "host": ["{{baseUrl}}"], "path": ["api","v1","categories","CAT001","children"] }
