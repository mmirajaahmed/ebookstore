{
  "info": {
    "name": "E-Bookstore API",
    "description": "12-step customer journey — mock JSON backed Spring Boot API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "ebookstore-mock-api-v1"
  },
  "item": [
    {
      "name": "📚 Catalog",
      "item": [
        {
          "name": "Step 1 — Browse All Books",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/catalog/books",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "catalog", "books"]
            }
          }
        },
        {
          "name": "Step 1b — Search Books (query)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/catalog/books?search=sci-fi",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "catalog", "books"],
              "query": [{ "key": "search", "value": "sci-fi" }]
            }
          }
        },
        {
          "name": "Step 2 — Filter by Category",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/catalog/books/category/CAT002",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "catalog", "books", "category", "CAT002"]
            }
          }
        },
        {
          "name": "Step 3 — Featured Books",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/catalog/books/featured",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "catalog", "books", "featured"]
            }
          }
        },
        {
          "name": "Step 4 — Book Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/catalog/books/B001",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "catalog", "books", "B001"]
            }
          }
        },
        {
          "name": "Admin — Create Book",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"The Pragmatic Programmer\",\n  \"author\": \"Andrew Hunt\",\n  \"publisher\": \"Addison-Wesley\",\n  \"isbn\": \"9780135957059\",\n  \"categoryId\": \"CAT005\",\n  \"brand\": \"Addison-Wesley\",\n  \"description\": \"From journeyman to master.\",\n  \"language\": \"English\",\n  \"pages\": 352,\n  \"format\": \"PAPERBACK\",\n  \"price\": 39.99,\n  \"discountPercent\": 0,\n  \"stock\": 25,\n  \"featured\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/catalog/books",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "catalog", "books"]
            }
          }
        },
        {
          "name": "Admin — Update Book",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"The Martian Chronicles (Updated)\",\n  \"author\": \"Ray Bradbury\",\n  \"price\": 12.99,\n  \"stock\": 50,\n  \"featured\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/catalog/books/B001",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "catalog", "books", "B001"]
            }
          }
        },
        {
          "name": "Admin — Delete Book",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/catalog/books/B001",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "catalog", "books", "B001"]
            }
          }
        }
      ]
    },
