    },
    {
      "name": "📦 Orders",
      "item": [
        {
          "name": "Step 8 — Place Order (Checkout)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"memberId\": \"M001\",\n  \"items\": [\n    { \"bookId\": \"B005\", \"title\": \"Atomic Habits\", \"quantity\": 1, \"unitPrice\": 18.00, \"discountPercent\": 0 },\n    { \"bookId\": \"B004\", \"title\": \"Clean Code\", \"quantity\": 1, \"unitPrice\": 45.99, \"discountPercent\": 15 }\n  ],\n  \"subtotal\": 63.99,\n  \"discountAmount\": 6.90,\n  \"taxAmount\": 4.57,\n  \"shippingFee\": 0.00,\n  \"totalAmount\": 61.66,\n  \"shippingAddressId\": \"A001\",\n  \"paymentId\": \"PAY001\",\n  \"notes\": \"Gift wrap please\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/orders", "host": ["{{baseUrl}}"], "path": ["api","v1","orders"] }
          }
        },
        {
          "name": "Step 9 — Order History for Member",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/orders/member/M001", "host": ["{{baseUrl}}"], "path": ["api","v1","orders","member","M001"] }
          }
        },
        {
          "name": "Get Single Order",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/orders/ORD001", "host": ["{{baseUrl}}"], "path": ["api","v1","orders","ORD001"] }
          }
        },
        {
          "name": "Admin — List All Orders",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/orders", "host": ["{{baseUrl}}"], "path": ["api","v1","orders"] }
          }
        },
        {
          "name": "Step 10 — Update Order Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{ \"status\": \"PROCESSING\" }"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/orders/ORD002/status", "host": ["{{baseUrl}}"], "path": ["api","v1","orders","ORD002","status"] }
          }
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/api/v1/orders/ORD003/cancel", "host": ["{{baseUrl}}"], "path": ["api","v1","orders","ORD003","cancel"] }
          }
        },
        {
          "name": "Step 11 — Track Shipment",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/orders/ORD001/shipment", "host": ["{{baseUrl}}"], "path": ["api","v1","orders","ORD001","shipment"] }
          }
        },
        {
          "name": "Admin — Create Shipment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"carrier\": \"FedEx\",\n  \"trackingNumber\": \"FX999000111US\",\n  \"status\": \"IN_TRANSIT\",\n  \"estimatedDelivery\": \"2025-06-05\",\n  \"origin\": \"Austin, TX\",\n  \"destination\": \"123 Maple St, Austin, TX\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/orders/ORD003/shipment", "host": ["{{baseUrl}}"], "path": ["api","v1","orders","ORD003","shipment"] }
          }
        },
        {
          "name": "Get Payment for Order",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/orders/ORD001/payment", "host": ["{{baseUrl}}"], "path": ["api","v1","orders","ORD001","payment"] }
          }
        },
        {
          "name": "Step 12 — Update Payment Status (Capture)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{ \"status\": \"CAPTURED\" }"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/orders/ORD002/payment/status", "host": ["{{baseUrl}}"], "path": ["api","v1","orders","ORD002","payment","status"] }
          }
        },
        {
          "name": "Step 12b — Update Payment Status (Refund)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{ \"status\": \"REFUNDED\", \"refundAmount\": 58.56 }"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/orders/ORD001/payment/status", "host": ["{{baseUrl}}"], "path": ["api","v1","orders","ORD001","payment","status"] }
          }
        }
      ]
