    {
      "name": "🛒 Cart",
      "item": [
        {
          "name": "Step 5 — View Cart",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/members/M001/cart", "host": ["{{baseUrl}}"], "path": ["api","v1","members","M001","cart"] }
